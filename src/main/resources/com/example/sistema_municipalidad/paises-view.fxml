<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Enlazamos tu archivo de estilos principal -->

<AnchorPane style="-fx-background-color: #F4F6F9;" stylesheets="@../../../estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sistema_municipalidad.controller.PaisesController">

    <VBox spacing="20" AnchorPane.bottomAnchor="25" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="25">

        <!-- ===================================================== -->
        <!-- 1. ENCABEZADO -->
        <!-- ===================================================== -->
        <VBox spacing="5">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #164E70;" styleClass="fuente-inter" text="Gestión de países" />

            <Label style="-fx-text-fill: #5d6f83;" styleClass="fuente-inter" text="Administración de los países disponibles para registrar turistas." />
        </VBox>

        <!-- ===================================================== -->
        <!-- 2. BARRA DE HERRAMIENTAS (BÚSQUEDA Y NUEVO) -->
        <!-- ===================================================== -->
        <HBox alignment="CENTER_LEFT" spacing="15">

            <!-- Campo de búsqueda estilizado -->
            <TextField fx:id="txtBuscar" prefWidth="300" promptText="🔍 Buscar país..." styleClass="campo-texto, fuente-inter" />

            <!-- Este Region empuja el botón "Nuevo" hacia el extremo derecho -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Botón de acción principal -->
            <Button fx:id="btnNuevo" onAction="#nuevoPais" styleClass="boton-primario, fuente-inter" text="+ Nuevo país" />
        </HBox>

        <!-- ===================================================== -->
        <!-- 3. TABLA -->
        <!-- ===================================================== -->
        <!-- El diseño de la tabla se aplicará automáticamente gracias al estilos.css -->
        <TableView fx:id="tablaPaises" stylesheets="@../../../estilos.css" VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="colNombre" prefWidth="453.0" text="Nombre del País" />
            </columns>

            <VBox.margin>
                <Insets bottom="5" top="5" />
            </VBox.margin>
         <styleClass>
            <String fx:value="fuente-inter" />
            <String fx:value="tabla-paises" />
         </styleClass>

        </TableView>

        <!-- ===================================================== -->
        <!-- 4. BOTONES DE ACCIÓN (MODIFICAR Y ELIMINAR) -->
        <!-- ===================================================== -->
        <HBox alignment="CENTER_RIGHT" spacing="15">

            <!-- Botón Eliminar: Le aplicamos un borde y texto rojo directo para indicar peligro -->
            <Button fx:id="btnEliminar" onAction="#eliminarPais" style="-fx-background-color: white; -fx-border-color: #ef4444; -fx-text-fill: #ef4444; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 8px 25px; -fx-cursor: hand; -fx-font-weight: bold;" styleClass="fuente-inter" text="Eliminar" />

            <!-- Botón Modificar: Usa la clase de marco azul -->
            <Button fx:id="btnModificar" onAction="#modificarPais" styleClass="boton-marco-azul, fuente-inter" text="Modificar" />

        </HBox>

    </VBox>

</AnchorPane>
